{
  "name": "dsh-persona-shell",
  "version": "0.4.8",
  "description": "在工作提示词之外，为 DeepSeek Harness 的助手汇报提供人格化转述，原文随时可查。",
  "type": "module",
  "main": "index.js",
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.2.2-0"
  },
  "license": "MIT",
  "author": "crisvollerei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crisvollerei/dsh-persona-shell.git"
  },
  "homepage": "https://github.com/crisvollerei/dsh-persona-shell#readme",
  "bugs": {
    "url": "https://github.com/crisvollerei/dsh-persona-shell/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "persona",
    "plugin"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "CHANGELOG.md",
    "docs/**/*.md",
    "docs/**/*.svg",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
