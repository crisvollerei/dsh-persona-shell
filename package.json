{
  "name": "dsh-persona-shell",
  "version": "0.4.3",
  "description": "Layer every assistant report in a persona outside the working prompt, with the original one click away.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "crisvollerei",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crisvollerei/dsh-persona-shell.git"
  },
  "homepage": "https://github.com/crisvollerei/dsh-persona-shell#readme",
  "bugs": {
    "url": "https://github.com/crisvollerei/dsh-persona-shell/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "persona",
    "plugin"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
